<section id="sync_progress_<%= catalog.id %>" class="mb-4 rounded-lg border p-4 <%= panel_classes %>" aria-label="Sync All progress">
  <div class="flex items-start justify-between gap-4">
    <h4 class="flex items-center gap-2 text-sm font-semibold <%= running? ? "text-blue-700" : text_classes %>">
      <% if state == :succeeded %>
        <svg class="h-5 w-5 shrink-0 text-green-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
      <% elsif !running? %>
        <svg class="h-5 w-5 shrink-0 text-amber-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
      <% end %>
      <%= heading %>
    </h4>

    <div class="flex items-center gap-3">
      <% if running? %>
        <span class="font-mono text-xs tabular-nums text-gray-600"
              title="Elapsed time"
              data-controller="elapsed-time"
              data-elapsed-time-seconds-value="<%= progress.elapsed %>"><%= format_elapsed(progress.elapsed) %></span>
      <% end %>
      <% if dismissible? %>
        <%= button_to helpers.sync_run_catalog_path(catalog),
            method: :delete,
            form_class: "inline-flex",
            class: "rounded-md p-1 #{text_classes} hover:bg-white/60 focus:outline-none focus:ring-2 focus:ring-blue-500" do %>
          <span class="sr-only">Dismiss sync progress</span>
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if running? %>
    <ol class="mt-2 flex flex-wrap gap-x-6 gap-y-1 text-sm text-gray-700">
      <li class="flex items-center gap-2">
        <% if progress.handed_off? %>
          <svg class="h-4 w-4 text-green-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          Sent to Shopify8
        <% else %>
          <span class="h-2 w-2 rounded-full bg-blue-600 animate-pulse motion-reduce:animate-none" aria-hidden="true"></span>
          Sending to Shopify8…
        <% end %>
      </li>
      <li class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-blue-600 animate-pulse motion-reduce:animate-none" aria-hidden="true"></span>
        Confirming in Shopify…
      </li>
    </ol>
  <% end %>

  <div class="mt-3 flex h-2.5 w-full overflow-hidden rounded-full bg-gray-200 <%= "bg-progress-stripes animate-progress-stripes motion-reduce:animate-none" if running? %>"
       role="progressbar"
       aria-label="Products answered by Shopify"
       aria-valuemin="0"
       aria-valuemax="<%= progress.total %>"
       aria-valuenow="<%= answered %>">
    <div data-segment="confirmed" class="h-full bg-green-600 transition-all duration-500 ease-out" style="width: <%= confirmed_width %>"></div>
    <div data-segment="failed" class="h-full bg-red-600 transition-all duration-500 ease-out" style="width: <%= failed_width %>"></div>
  </div>

  <p class="mt-2 flex flex-wrap items-center gap-x-3 text-sm <%= text_classes %>">
    <span aria-live="polite"><%= status_line %></span>
    <% if state == :finished_with_failures %>
      <%= link_to "Show failed", helpers.catalog_items_path(catalog, sync_status: "failed"),
          class: "font-medium text-blue-700 underline hover:text-blue-900" %>
    <% end %>
  </p>
</section>
