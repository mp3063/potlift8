<%= turbo_stream.replace "product-header-#{@product.id}" do %>
  <%= turbo_frame_tag "product-header-#{@product.id}", target: "_top" do %>
    <%= render Products::HeaderComponent.new(product: @product) %>
  <% end %>
<% end %>

<%= turbo_stream.update "flash" do %>
  <%= render "shared/flash" %>
<% end %>
